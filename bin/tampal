#!/bin/sh
# tampal — open the front-end editor, or look after its server.
#
#   tampal            open tampal in the browser on this Mac (pairs it the first time)
#   tampal phone      print the link that pairs the iPhone (open it once in Safari)
#   tampal status     is the server up, and is the iPhone link up
#   tampal restart    restart the server after a code change
#   tampal log        follow the server log
ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
PORT=4490
TSPORT=8444
LABEL=com.luqman.tampal
TS() { /opt/homebrew/opt/tailscale/bin/tailscale --socket="$HOME/Library/Application Support/tailscale-user/tailscaled.sock" "$@"; }
key() { cat "$ROOT/data/key"; }

case "${1:-open}" in
  open)    open "http://127.0.0.1:$PORT/pair?key=$(key)" ;;
  phone)   name=$(TS status --json 2>/dev/null | python3 -c 'import json,sys; print(json.load(sys.stdin)["Self"]["DNSName"].rstrip("."))' 2>/dev/null)
           [ -n "$name" ] || { echo "Tailscale is not running on this Mac."; exit 1; }
           echo "https://$name:$TSPORT/pair?key=$(key)" ;;
  status)  printf 'server     '; curl -s -o /dev/null -w '%{http_code}\n' "http://127.0.0.1:$PORT/" || echo down
           printf 'login item '; launchctl list | grep -q "$LABEL" && echo loaded || echo "not loaded"
           printf 'iphone     '; TS serve status 2>/dev/null | grep -q ":$TSPORT" && echo "serving on :$TSPORT" || echo "not served" ;;
  restart) launchctl kickstart -k "gui/$(id -u)/$LABEL" && echo restarted ;;
  log)     tail -f "$ROOT/data/logs/server.log" ;;
  *)       sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//' ;;
esac
